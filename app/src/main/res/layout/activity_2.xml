<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- 1. 위험물 사용 여부 (최상단) -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchHazardous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="위험물 사용 여부"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 2. 특이사항 입력 박스 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutNote"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="특이사항을 입력하세요"
        app:layout_constraintTop_toBottomOf="@+id/switchHazardous">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. 설정 저장 버튼 (파스텔 주황) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:text="설정 저장"
        app:backgroundTint="#FFB74D"
        android:textColor="#000000"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutNote" />

    <!-- 구분선 (시각적 분리를 위한 원리 적용) -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:background="#DDDDDD"
        app:layout_constraintTop_toBottomOf="@+id/btnSave" />

    <!-- 4. 아이디 검색 칸 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutSearchId"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="검색할 아이디를 입력하세요"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:layout_constraintTop_toBottomOf="@+id/divider">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 5. 검색 버튼 (파스텔 연두) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSearch"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="아이디 검색"
        app:backgroundTint="#9CCC65"
        android:textColor="#FFFFFF"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutSearchId" />

</androidx.constraintlayout.widget.ConstraintLayout>